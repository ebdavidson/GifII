9 REM On initial load, move the program past PAGE 2 memory block, then reload the program
10 IF PEEK(104) = 8 THEN POKE 104,12 : POKE 3072,0 : PRINT CHR$(4)"RUN STARTUP"

29 REM FI == Frame Index, counter for index of the current frame being displayed
30 FI = 1

39 REM FD = Frames Delayed, counter for amount of loops done on the current frame waiting to move to the next frame
40 FD = 0

45 REM FC = Frame Count, the actual number of frames in the animation
46 FC = 0

49 REM DL == Delay List, the amount of loops to delay for each frame. Two-byte signed integers. Generated by the C++ program
50 DIM DL%(256)

51 REM Array addresses can be calculated with (pointer high byte)(pointer low byte) + 7 byes for header
52 REM LM = List Memory, the eventual address of the Delay List array 
53 REM The first index is the actual number of frames, subsequent indices are the frame delay time
54 LM = PEEK(108) * 256 + PEEK(107) + 7

60 PRINT CHR$(4)"BLOAD DELAY.SLO,A" + STR$(LM)

70 FC = DL%(0)

89 REM This switches to PAGE 2 memory display and enables full-screen lo-res graphics
90 POKE 49237,1 : POKE -16302,0 : POKE -16304,0

99 REM Infinite loop: load the current frame into PAGE 2 memory, delay the loop count in delay list, then proceed to next frame
100 PRINT CHR$(4)"BLOAD X" + STR$(FI-1) + ".SLO,A$800"
110 IF FD < DL%(FI) THEN FD = FD + 1 : GOTO 110
120 FD = 0
130 FI = FI + 1
140 IF FI = FC THEN FI = 1
150 GOTO 100