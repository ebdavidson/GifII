9 REM On initial load, move the program past PAGE 2 memory block, then reload the program
10 IF PEEK(104) = 8 THEN POKE 104,12 : POKE 3072,0 : PRINT CHR$(4)"RUN STARTUP"

19 REM FI == Frame Index, counter for index of the current frame being displayed
20 FI = 0

29 REM FC = Frame Count, the total number of frames. Generated by the C++ program
30 FC = [FRAMES_REPLACE]

39 REM FD = Frames Delayed, counter for amount of loops done on the current frame waiting to move to the next frame
40 FD = 0

49 REM DL == Delay List, the amount of loops to delay for each frame. Generated by the C++ program
50 DIM DL(FC)
60 FOR I = 0 TO FC - 1 : READ DL(I) : NEXT I
70 DATA [DATA_REPLACE]

89 REM This switches to PAGE 2 memory display and enables full-screen lo-res graphics
90 POKE 49237,1 : POKE -16302,0 : POKE -16304,0

99 REM Infinite loop: load the current frame into PAGE 2 memory, delay the loop count in delay list, then proceed to next frame
100 PRINT CHR$(4)"BLOAD X" + STR$(FI) + ".SLO,A$800"
110 IF FD < DL(FI) THEN FD = FD + 1 : GOTO 110
120 FD = 0
130 FI = FI + 1
140 IF FI = FC THEN FI = 0
150 GOTO 100